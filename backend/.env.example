# Google Sheet used as the datastore. The backend connects to it directly
# using a service account below - nobody needs to sign in with Google.
SPREADSHEET_ID=18Aqu6Xt_eWgXvIrYPuuz4kCKyVay_rcNdzK_E7DvDwk

# Service account credentials for server-side Google Sheets access.
# Set ONE of the two options below:
#   1) Path to the downloaded JSON key file (simplest for local dev)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
#   2) OR the JSON key contents inline (handy when you can only set env
#      vars, e.g. most PaaS/container platforms). Leave FILE blank if used.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Remember to share the spreadsheet (Editor access) with the service
# account's client_email - see backend/README.md for the full setup.

# Optional: used only for the /api/live-rates/regional lookup. If unset,
# that endpoint falls back to public exchange-rate/gold-price APIs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime (seconds) and login brute-force protection.
SESSION_TTL_SECONDS=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# Set to "true" only if you want the API to auto-create a first admin
# account (with a random generated password printed to the server log)
# when the Users sheet is empty. Leave "false" and add users yourself
# if you'd rather not have the API write credentials at all.
SEED_DEFAULT_USERS=false

# development | production
ENV=development
